# Neo4j (defaults work with docker-compose)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# OpenRouter (RAG answer model). Copy this file to .env and set your key.
# If OPENROUTER_API_KEY is set, the app uses OpenRouter instead of Ollama for RAG answers.
# Get an API key at https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2.5
